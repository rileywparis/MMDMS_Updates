                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!BALANCE.Value = -99999, "", Fields!BALANCE.Value)</Value>
