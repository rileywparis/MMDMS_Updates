                                              <TablixCell>
                                                <CellContents>
                                                  <Textbox Name="Estimate">
                                                    <KeepTogether>true</KeepTogether>
                                                    <Paragraphs>
                                                      <Paragraph>
                                                        <TextRuns>
                                                          <TextRun>
                                                            <Value EvaluationMode="Constant" />
                                                            <Style>
                                                              <FontSize>9pt</FontSize>
                                                              <FontWeight>Normal</FontWeight>
                                                            </Style>
                                                          </TextRun>
                                                        </TextRuns>
