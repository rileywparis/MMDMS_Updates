                                                        <Style>None</Style>
                                                      </Border>
                                                      <VerticalAlign>Top</VerticalAlign>
                                                    </Style>
                                                  </Textbox>
                                                </CellContents>
                                              </TablixCell>
                                              <TablixCell>
                                                <CellContents>
                                                  <Textbox Name="Curr">
                                                    <KeepTogether>true</KeepTogether>
                                                    <Paragraphs>
                                                      <Paragraph>
                                                        <TextRuns>
                                                          <TextRun>
                                                            <Value>=IIf(Fields!UTILITY.Value = 1, Fields!READING.Value, "-")</Value>
