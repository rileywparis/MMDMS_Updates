                                              <TablixCell>
                                                <CellContents>
                                                  <Textbox Name="Usage">
                                                    <KeepTogether>true</KeepTogether>
                                                    <Paragraphs>
                                                      <Paragraph>
                                                        <TextRuns>
                                                          <TextRun>
                                                            <Value>=IIf(
    Fields!UTILITY.Value = 8,
    CStr(Fields!UTIL_NAME.Value),
    IIf(
        Fields!UTILITY.Value = 1,
        CStr(Fields!BILL_USAGE.Value),
        "-"
    )
)</Value>
                                                            <Style>
                                                              <FontSize>9pt</FontSize>
                                                              <FontWeight>Normal</FontWeight>
                                                            </Style>
                                                          </TextRun>
                                                        </TextRuns>
                                                        <Style>
                                                          <TextAlign>Center</TextAlign>
                                                        </Style>
