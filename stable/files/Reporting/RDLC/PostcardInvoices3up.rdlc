                                                      <Paragraph>
                                                        <TextRuns>
                                                          <TextRun>
                                                            <Value>=IIf(
    Fields!UTILITY.Value = 8,
    "-",
    Fields!UTIL_NAME.Value
)</Value>
                                                            <Style>
                                                              <FontSize>9pt</FontSize>
                                                              <FontWeight>Normal</FontWeight>
                                                            </Style>
                                                          </TextRun>
                                                        </TextRuns>
