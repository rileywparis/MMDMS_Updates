                                          <TablixRow>
                                            <Height>0.15in</Height>
                                            <TablixCells>
                                              <TablixCell>
                                                <CellContents>
                                                  <Textbox Name="Prior">
                                                    <KeepTogether>true</KeepTogether>
                                                    <Paragraphs>
                                                      <Paragraph>
                                                        <TextRuns>
                                                          <TextRun>
                                                            <Value>=IIf(Fields!UTILITY.Value = 1, Fields!CUR_READ.Value, "-")</Value>
                                                            <Style>
                                                              <FontSize>9pt</FontSize>
                                                              <FontWeight>Normal</FontWeight>
                                                            </Style>
                                                          </TextRun>
                                                        </TextRuns>
                                                        <Style>
                                                          <TextAlign>Right</TextAlign>
                                                        </Style>
                                                      </Paragraph>
                                                    </Paragraphs>
                                                    <Style>
